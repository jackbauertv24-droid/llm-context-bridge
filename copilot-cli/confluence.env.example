# confluence.env.example — Optional settings for the Confluence skill.
#
# No credentials or passwords are required here!
# The bridge attaches to your already-signed-in Chrome tab via CDP (port 9222),
# so authentication uses your existing browser SSO session automatically.

# Substring or URL pattern used to identify the Confluence tab in Chrome.
# Default: confluence (matches any tab with 'confluence' in URL or title).
# Examples:
#   CONFLUENCE_TAB_MATCH=confluence.corp.example.com
#   CONFLUENCE_TAB_MATCH=wiki.mycompany.com
CONFLUENCE_TAB_MATCH=confluence

# Maximum characters extracted per page before truncation.
# Keeps massive documents from overflowing the LLM context window.
# Default: 25000
CONFLUENCE_MAX_CHARS=25000

# Timeout in milliseconds for in-tab queries.
# Default: 20000 (20 seconds)
CONFLUENCE_TIMEOUT_MS=20000

# Chrome DevTools Protocol port and host (usually default).
CDP_HOST=127.0.0.1
CDP_PORT=9222
