# Copy to mail.env and fill in. mail.env is gitignored; this example is not.
#
# Reading is strictly read-only: the mailbox is opened with EXAMINE and bodies
# are fetched with BODY.PEEK, so nothing is marked as read and nothing on the
# server changes. See README > Reading mail.

MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_TLS=1

MAIL_USER=you@example.com
# A password, or better an app-specific password. Gmail and most providers
# require one when two-factor authentication is on.
MAIL_PASS=

# Instead of MAIL_PASS, for a server that only allows OAuth. Microsoft 365
# turned basic IMAP auth off by default in 2023, so a corporate mailbox will
# usually need this rather than a password.
# MAIL_OAUTH_TOKEN=

# Defaults for the agent's mail tool; each can be overridden per call.
MAIL_FOLDER=INBOX
MAIL_DAYS=7
MAIL_LIMIT=25

# Size budget, so a busy inbox cannot swamp the prompt.
MAIL_MAX_BODY=2000
MAIL_MAX_TOTAL=40000

# Strips tokens, keys and "password: ..." from mail before it is sent to the
# chat. 0 turns it off.
MAIL_REDACT=1
