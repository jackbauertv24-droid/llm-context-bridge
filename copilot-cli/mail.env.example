# Copy to mail.env and fill in. mail.env is gitignored; this example is not.
#
# READ ONLY, ALWAYS. This tool can read mail and nothing else. It never sends,
# never replies, never forwards, never moves or deletes, and never sets the
# read flag. That is enforced in the code, not by configuration, so there is
# no setting here that can turn it off. See README > Reading mail.

# ---------------------------------------------------------------- Exchange
# The default, and the method to use against an on-premises Exchange: the
# same /EWS/Exchange.asmx endpoint an Outlook client talks to. Ask whoever
# runs your mail for the URL, or take it from any existing integration.
MAIL_PROTOCOL=ews
MAIL_EWS_URL=https://owa.example.com/EWS/Exchange.asmx

# Often DOMAIN\username rather than an email address, depending on the server.
MAIL_USER=DOMAIN\username
MAIL_PASS=

# The version declared to the server. Exchange2010_SP2 is the safe floor and
# is accepted by every later server; raise it only if you need newer fields.
MAIL_EWS_VERSION=Exchange2010_SP2

# Set to 1 only if the endpoint uses an internal certificate authority that
# this machine does not trust. It disables certificate checking, so prefer
# installing the CA certificate instead.
MAIL_TLS_INSECURE=0

# -------------------------------------------------------------------- IMAP
# An alternative for servers that offer it. Leave MAIL_EWS_URL unset and set
# MAIL_PROTOCOL=imap to use this path instead.
# MAIL_PROTOCOL=imap
# MAIL_HOST=imap.example.com
# MAIL_PORT=993
# MAIL_TLS=1
# MAIL_OAUTH_TOKEN=          # XOAUTH2, instead of MAIL_PASS

# ---------------------------------------------------------------- defaults
# Each of these can be overridden per call by the agent.
MAIL_FOLDER=Inbox
MAIL_DAYS=7
MAIL_LIMIT=25

# Size budget, so a busy mailbox cannot swamp the prompt.
MAIL_MAX_BODY=2000
MAIL_MAX_TOTAL=40000

# Strips tokens, keys and "password: ..." from mail before it reaches the
# chat. 0 turns it off.
MAIL_REDACT=1
